{
  "name": "diboas-platform",
  "version": "1.0.0",
  "description": "diBoaS Platform - Unified Financial Services",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "validate:design-tokens": "node scripts/validate-design-tokens.js",
    "generate:design-tokens": "echo 'DISABLED: design-tokens.css is hand-maintained — regenerating would overwrite 2500+ lines of hand-tuned CSS. See the Design Tokens section in CLAUDE.md.' && exit 1",
    "dev:web": "turbo run dev --filter=web",
    "dev:clean": "npx --yes kill-port 3000 2>/dev/null; pnpm -w run dev:web",
    "dev:reset": "rm -rf apps/web/.next .turbo && pnpm -w run dev:web",
    "dev:fresh": "rm -rf apps/web/.next .turbo && pnpm --filter @diboas/i18n build && pnpm -w run dev:web",
    "performance:audit": "turbo run lighthouse",
    "accessibility:audit": "turbo run pa11y",
    "security:audit": "pnpm audit --audit-level high --prod",
    "secrets:scan": "gitleaks detect --redact --verbose --no-banner --config=.gitleaks.toml",
    "secrets:scan-staged": "bash scripts/secrets-scan-staged.sh",
    "hooks:install": "simple-git-hooks",
    "analytics:report": "turbo run analytics-report",
    "validate:translations": "node packages/i18n/scripts/validate-translations.js",
    "validate:market-data": "node scripts/check-market-data-jargon.mjs && pnpm --filter web exec vitest run src/lib/analytics-sdk/__tests__/fixtures.test.ts",
    "validate:sdk-invariant": "node scripts/validate-sdk-invariant.mjs",
    "validate:investor-figures": "node scripts/validate-investor-figures.mjs",
    "validate:ux-canon": "node scripts/validate-ux-canon.mjs",
    "check:ux-greps": "node scripts/check-ux-greps.mjs",
    "check:dead-code": "knip --exclude exports,nsExports,types,nsTypes,duplicates",
    "check:dead-code:full": "knip",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "validate:all": "pnpm run type-check && pnpm run lint && pnpm run test && pnpm run build && pnpm run check:budget && pnpm run validate:design-tokens && pnpm run validate:translations && pnpm run validate:market-data && pnpm run validate:sdk-invariant && pnpm run validate:investor-figures && pnpm run validate:seo && pnpm run validate:ux-canon",
    "audit:full": "bash scripts/pre-launch-audit.sh",
    "audit:ci": "bash scripts/pre-launch-audit.sh --ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:investor-docs": "node scripts/generate-investor-docs.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "dev:sandbox": "turbo run build --filter=@diboas/banking --filter=@diboas/defi --filter=@diboas/investing && pnpm --filter sandbox dev",
    "start:sandbox": "pnpm --filter sandbox start"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.18.0",
    "eslint": "^10.8.1",
    "knip": "^5.86.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.9",
    "typescript": "~5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run secrets:scan-staged"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "js-yaml": "^4.1.1",
      "glob": "^10.5.0",
      "next": "16.2.12",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@<3.0.0": ">=3.1.2",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "serialize-javascript@<=7.0.2": "7.0.3",
      "tailwindcss": "3.4.17",
      "fast-uri": ">=4.1.1",
      "axe-core": "4.11.1",
      "tmp": ">=0.2.6",
      "dompurify": "3.4.12",
      "@opentelemetry/semantic-conventions": "1.40.0",
      "postcss@<8.5.18": "8.5.18",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.8"
    }
  }
}
