{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "ENCRYPTION_KEY",
        "HMAC_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM_ADDRESS",
        "INTERNAL_API_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "PA11Y_DISABLE_IMAGE_OPT",
        "CRON_SECRET",
        "SANDBOX_ACCESS_PASSWORD",
        "COINGECKO_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DEV_ALLOWED_ORIGINS", "SANDBOX_ACCESS_PASSWORD", "COINGECKO_API_KEY"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"],
      "passThroughEnv": ["DIBOAS_DOCS_DIR"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "lighthouse": {
      "dependsOn": ["build"],
      "outputs": ["lighthouse-reports/**"]
    },
    "pa11y": {
      "dependsOn": ["build"],
      "outputs": ["accessibility-reports/**"]
    },
    "analytics-report": {
      "outputs": ["analytics-reports/**"]
    }
  }
}
