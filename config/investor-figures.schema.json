{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "diBoaS Investor Figures Registry",
  "description": "Single source of truth for every settled investor-facing number. Room sources reference entries via {{fig:id}} tokens; the generator resolves them at build time. See docs/audit/FIGURES_REGISTRY_IMPLEMENTATION_PLAN_2026-07-06.md.",
  "type": "object",
  "required": ["figures"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "figures": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)*$": {
          "type": "object",
          "required": ["value", "source", "asOf", "status"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["en"],
                  "additionalProperties": false,
                  "properties": {
                    "en": { "type": "string", "minLength": 1 },
                    "pt-BR": { "type": "string", "minLength": 1 },
                    "de": { "type": "string", "minLength": 1 },
                    "es": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            },
            "source": {
              "type": "string",
              "pattern": "^(FEES\\.md|DECISION_LOG#D-[0-9]{3}|business-plan|use-of-funds|revenue-model|FINANCIAL_MAP|verified-stat)$"
            },
            "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "status": { "type": "string", "enum": ["active", "pending"] },
            "note": { "type": "string" },
            "feesRow": {
              "type": "string",
              "description": "FEES.md table row (matched by action name) that must contain every feesCanonical string — local gate only"
            },
            "feesCanonical": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Canonical value strings the FEES.md row must contain (decoupled from per-locale prose formatting)"
            },
            "anchors": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "For DECISION_LOG# sources: strings the decision log must contain — local gate only"
            },
            "forbidLiterals": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Regex sources banned from generated investor-docs.json once this figure is active (superseded literals)"
            }
          }
        }
      }
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "locales", "minCount", "why"],
        "additionalProperties": false,
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "locales": {
            "type": "array",
            "items": { "type": "string", "enum": ["en", "pt-BR", "de", "es"] },
            "minItems": 1
          },
          "minCount": { "type": "integer", "minimum": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
