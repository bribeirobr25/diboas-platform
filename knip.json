{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["du", "tsx", "gitleaks", "sleep", "storybook"],
  "workspaces": {
    "apps/web": {
      "eslint": false,
      "entry": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/route.ts",
        "src/app/**/loading.tsx",
        "src/app/**/error.tsx",
        "src/app/**/not-found.tsx",
        "src/app/**/global-error.tsx",
        "src/app/globals.css",
        "src/test/**",
        "src/types/**",
        "src/styles/**",
        "src/config/**",
        "src/components/**/*.stories.tsx",
        "next.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "sentry.*.config.*"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx}",
        "next.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "sentry.*.config.*"
      ],
      "ignore": ["src/lib/analytics-sdk/theme.ts", "src/lib/waitingList/domain/**"],
      "ignoreDependencies": [
        "@storybook/*",
        "pa11y",
        "@eslint/js",
        "eslint-config-next",
        "eslint-plugin-storybook"
      ]
    },
    "packages/i18n": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/email": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/sandbox": {
      "ignore": ["src/lib/database/client.ts"]
    }
  }
}
