# diBoaS Sandbox — environment (MVP-0)

# The shared access password for the private prototype gate (fail-closed:
# without it, nobody enters). Set your own value in .env.local.
# Open the app publicly, skipping the shared-password gate (founder 2026-08-22).
# Explicit opt-in only — an unset SANDBOX_ACCESS_PASSWORD still fails CLOSED.
# Does not relax the geofence, noindex, or the play-money labelling.
SANDBOX_PUBLIC_ACCESS=

SANDBOX_ACCESS_PASSWORD=

# Optional: CoinGecko Demo API key (free tier — founder prerequisite §11 of
# the proposal). Without it the price provider uses the keyless public
# endpoint with a generous server-side cache, degrading to documented
# fixtures if unreachable. Server-side only, never NEXT_PUBLIC.
COINGECKO_API_KEY=

# Testing-only: relax the gate cookie's `secure` flag so the Docker MCP visual
# protocol can hold a session over a plain-http LAN IP. NEVER set in a deployed
# environment (Vercel is HTTPS; localhost is already a secure context) — and as
# of I-1.1b the code REFUSES it on Vercel production and preview, so the rule no
# longer rests on remembering it.
SANDBOX_GATE_ALLOW_INSECURE=

# Persistent Practice accounts + the Legal readiness architecture that precedes
# them (I-0b). Explicit opt-in, internal builds only. Production stays OFF until
# an explicit later Legal / Founder public-release clearance — the code supports
# that activation, and nothing here authorizes it.
PRACTICE_ACCOUNTS_ENABLED=

# Real Money parity through pre-authorization (I-8), internal only. A Vercel
# PRODUCTION deployment refuses this flag regardless of its value; a preview may
# carry it, which is what preview is for.
REAL_PARITY_INTERNAL=

# I-1e mode PALETTE. The shell always states the mode TRUTH (`data-mode`); this
# flag adds the provisional practice/real PALETTE (`data-palette`), which
# re-tints every Practice screen from teal to periwinkle. The practice/real
# token values are unreviewed calibration (register 5.282), so this stays unset
# until Product/UIUX approves them. Explicit opt-in: `=== 'true'`.
SANDBOX_MODE_PALETTE=

# The sandbox's OWN Neon Postgres project (separate from the platform/waitlist
# DB — one-migrations-owner-per-database, SANDBOX_RULES R-6). Use the POOLED
# connection string. Server-side only, never NEXT_PUBLIC. Consumed by the
# ledger store from Phase 2; the migration runner (db:migrate/db:status) uses
# it now via `node --env-file=.env.local`.
DATABASE_URL=

# Geofence kill-switch (P1.1). Default = ON; set to `false` ONLY to disable the
# CN/RU/KP edge denylist. Server-side only.
SANDBOX_GEO_ENABLED=

# Testing-only geofence override (non-prod). Set to an ISO country code (e.g.
# CN) to simulate that region locally. NEVER set in production — the middleware
# ignores it when NODE_ENV==='production', but it does not belong in a deployed
# env either.
SANDBOX_GEO_OVERRIDE=
