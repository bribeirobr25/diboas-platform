{
  "name": "sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "diBoaS Sandbox — the product in practice mode (play money, real data). Governed by docs/sandbox-app/.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local src/lib/database/migrate.mjs migrate",
    "db:status": "node --env-file=.env.local src/lib/database/migrate.mjs status"
  },
  "dependencies": {
    "@diboas/banking": "workspace:*",
    "@diboas/defi": "workspace:*",
    "@diboas/investing": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.544.0",
    "next": "16.2.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.1.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  }
}
