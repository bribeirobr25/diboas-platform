{
  "name": "sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "diBoaS Practice app — play money, real market data. Governed by docs/domains/practice/.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint src e2e playwright.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "screen-check": "node scripts/screen-check.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:migrate": "node --env-file=.env.local src/lib/database/migrate.mjs migrate",
    "db:status": "node --env-file=.env.local src/lib/database/migrate.mjs status"
  },
  "dependencies": {
    "@diboas/banking": "workspace:*",
    "@diboas/defi": "workspace:*",
    "@diboas/format": "workspace:*",
    "@diboas/investing": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.41.0",
    "decimal.js": "^10.4.3",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.4.7"
  },
  "devDependencies": {
    "@diboas/test-support": "workspace:*",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/nextjs": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "happy-dom": "^21.0.4",
    "storybook": "^10.6.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
