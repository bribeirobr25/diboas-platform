{
  "name": "sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "diBoaS Sandbox \u2014 the product in practice mode (play money, real data). Governed by docs/sandbox-app/.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "screen-check": "node scripts/screen-check.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:migrate": "node --env-file=.env.local src/lib/database/migrate.mjs migrate",
    "db:status": "node --env-file=.env.local src/lib/database/migrate.mjs status"
  },
  "dependencies": {
    "@diboas/banking": "workspace:*",
    "@diboas/defi": "workspace:*",
    "@diboas/investing": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.4.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^21.0.3",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
