{
  "name": "@diboas/test-support",
  "version": "0.1.0",
  "private": true,
  "description": "Test-only helpers for source-scanning guards (comment stripping by the TypeScript parser). Never imported by runtime code.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
